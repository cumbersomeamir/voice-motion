{
  "name": "voicemotion-ai-backend",
  "version": "1.0.0",
  "description": "VoiceMotion AI Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "express": "^4.18.3",
    "mongoose": "^8.2.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "dotenv": "^16.4.5",
    "zod": "^3.22.4",
    "winston": "^3.12.0",
    "redis": "^4.6.13",
    "bull": "^4.12.2",
    "razorpay": "^2.9.2",
    "resend": "^3.2.0",
    "speakeasy": "^2.0.0",
    "axios": "^1.6.7",
    "multer": "^1.4.5-lts.1",
    "aws-sdk": "^2.1570.0",
    "uuid": "^9.0.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^3.3.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "openai": "^4.28.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ]
  }
}
